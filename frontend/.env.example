# Penny Mobile Frontend Environment Variables
# Copy to .env or run `npm run sync-ip` to auto-populate your current LAN IP

# Backend API endpoint (used by PennyApiClient in frontend/src/services/api.ts)
# For physical mobile testing on Wi-Fi: http://<YOUR_LOCAL_IP>:8000/api/v1
# For web / emulator: http://localhost:8000/api/v1
EXPO_PUBLIC_API_URL=http://localhost:8000/api/v1
